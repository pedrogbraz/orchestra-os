#!/usr/bin/env bash
set -euo pipefail

ORCHESTRA_IMAGE="${ORCHESTRA_IMAGE:-orchestra-os/agent-sandbox:latest}"
ORCHESTRA_WORKTREE_ROOT="${ORCHESTRA_WORKTREE_ROOT:-$HOME/.orchestra/worktrees}"
ORCHESTRA_AGENT_HOME="${ORCHESTRA_AGENT_HOME:-$HOME/.orchestra/agent-home}"
ORCHESTRA_ENV_FILE="${ORCHESTRA_ENV_FILE:-$HOME/.config/orchestra/env}"

usage() {
  cat <<'EOF'
orchestra - run isolated AI coding agents on git worktrees + containers

Usage:
  orchestra new <agent> <repo-path> [branch] [--cpus N] [--memory SIZE]
                                               Create a worktree + sandboxed container for an agent
                                               (default: half the CPU cores, 4g; 0 means no limit)
  orchestra list                               List running agent containers
  orchestra attach <agent>                     Attach to a running agent's shell
  orchestra stop <agent>                       Stop an agent's container (keeps the worktree)
  orchestra rm <agent>                         Stop the container and remove the worktree
EOF
}

cmd_new() {
  local cores cpus memory
  cores="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
  # Default to half the host's cores and 4 GB so one runaway agent can't starve the machine or the other agents.
  cpus="${ORCHESTRA_CPUS:-$(( cores > 1 ? cores / 2 : 1 ))}"
  memory="${ORCHESTRA_MEMORY:-4g}"

  local -a positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cpus) cpus="${2:?--cpus needs a value}"; shift 2 ;;
      --cpus=*) cpus="${1#--cpus=}"; shift ;;
      --memory) memory="${2:?--memory needs a value}"; shift 2 ;;
      --memory=*) memory="${1#--memory=}"; shift ;;
      -*) echo "orchestra: unknown option: $1" >&2; exit 1 ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  if [[ ${#positional[@]} -lt 2 ]]; then
    usage
    exit 1
  fi
  set -- "${positional[@]}"
  local agent="$1" repo_path="$2"
  local branch="${3:-agent/$agent}"
  local repo_name worktree_path git_common_dir

  if ! repo_path="$(git -C "$repo_path" rev-parse --show-toplevel 2>/dev/null)"; then
    echo "orchestra: '$2' is not a git repository" >&2
    exit 1
  fi
  repo_name="$(basename "$repo_path")"
  worktree_path="$ORCHESTRA_WORKTREE_ROOT/$repo_name-$agent"
  git_common_dir="$(git -C "$repo_path" rev-parse --path-format=absolute --git-common-dir)"

  if docker container inspect "orchestra-$agent" >/dev/null 2>&1; then
    echo "orchestra: agent '$agent' already exists (remove it first: orchestra rm $agent)" >&2
    exit 1
  fi
  if [[ -e "$worktree_path" ]]; then
    echo "orchestra: worktree path already exists: $worktree_path" >&2
    exit 1
  fi

  mkdir -p "$ORCHESTRA_WORKTREE_ROOT" "$ORCHESTRA_AGENT_HOME"

  # Never reset an existing branch: it may hold commits from a previous agent.
  local created_branch=0
  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "Reusing existing branch '$branch'."
    git -C "$repo_path" worktree add "$worktree_path" "$branch"
  else
    git -C "$repo_path" worktree add -b "$branch" "$worktree_path"
    created_branch=1
  fi

  local -a env_args=(-e HOME=/home/agent)
  local git_name git_email var
  git_name="$(git -C "$repo_path" config user.name || true)"
  git_email="$(git -C "$repo_path" config user.email || true)"
  if [[ -n "$git_name" ]]; then
    env_args+=(-e "GIT_AUTHOR_NAME=$git_name" -e "GIT_COMMITTER_NAME=$git_name")
  fi
  if [[ -n "$git_email" ]]; then
    env_args+=(-e "GIT_AUTHOR_EMAIL=$git_email" -e "GIT_COMMITTER_EMAIL=$git_email")
  fi
  # Pass keys by name only, so their values never show up in the process list.
  for var in ANTHROPIC_API_KEY OPENAI_API_KEY GEMINI_API_KEY OPENROUTER_API_KEY; do
    if [[ -n "${!var:-}" ]]; then
      env_args+=(-e "$var")
    fi
  done
  if [[ -f "$ORCHESTRA_ENV_FILE" ]]; then
    env_args+=(--env-file "$ORCHESTRA_ENV_FILE")
  fi

  # Claude Code names Remote Control sessions after the hostname; the default (container id) is unreadable.
  local container_hostname
  container_hostname="$(printf '%s' "$agent" | tr -c 'A-Za-z0-9-' '-' | cut -c1-63)"

  # Run as the host user so agent-created files stay editable/removable on the host.
  # The worktree's .git file points at an absolute path in the main repo, so mount it at the same path.
  # A shared persistent HOME keeps agent logins (claude, codex, aider) across agents.
  if ! docker run -d \
    --name "orchestra-$agent" \
    --label "orchestra.agent=$agent" \
    --label "orchestra.repo=$repo_name" \
    --label "orchestra.repo_path=$repo_path" \
    --label "orchestra.branch=$branch" \
    --label "orchestra.cpus=$cpus" \
    --label "orchestra.memory=$memory" \
    --hostname "$container_hostname" \
    --cpus "$cpus" \
    --memory "$memory" \
    --user "$(id -u):$(id -g)" \
    "${env_args[@]}" \
    -v "$ORCHESTRA_AGENT_HOME:/home/agent" \
    -v "$worktree_path:/workspace" \
    -v "$git_common_dir:$git_common_dir" \
    -w /workspace \
    "$ORCHESTRA_IMAGE" \
    sleep infinity >/dev/null; then
    # Don't leave a worktree behind when the container fails to start, or the next `new` refuses to run.
    git -C "$repo_path" worktree remove --force "$worktree_path"
    if [[ $created_branch == 1 ]]; then
      git -C "$repo_path" branch -D "$branch" >/dev/null
    fi
    exit 1
  fi

  # The host uid has no passwd entry in the image: shells show "I have no name!" and getpwuid-based tools fail.
  docker exec -u 0 "orchestra-$agent" sh -c \
    "grep -q ':x:$(id -u):' /etc/passwd || echo 'agent:x:$(id -u):$(id -g)::/home/agent:/bin/sh' >> /etc/passwd"

  echo "Agent '$agent' ready."
  echo "Worktree: $worktree_path"
  echo "Limits: $cpus CPUs, $memory memory"
  echo "Attach with: orchestra attach $agent"
}

cmd_list() {
  docker ps --filter "label=orchestra.agent" \
    --format 'table {{.Names}}\t{{.Label "orchestra.agent"}}\t{{.Label "orchestra.repo"}}\t{{.Label "orchestra.cpus"}}\t{{.Label "orchestra.memory"}}\t{{.Status}}'
}

cmd_attach() {
  local agent="$1" shell=bash
  # Pick the shell up front: falling back on fish's exit status reopened bash whenever a fish session ended non-zero.
  if docker exec "orchestra-$agent" sh -c 'command -v fish' >/dev/null 2>&1; then
    shell=fish
  fi
  docker exec -it "orchestra-$agent" "$shell"
}

cmd_stop() {
  local agent="$1"
  docker stop "orchestra-$agent"
}

cmd_rm() {
  local agent="$1" worktree_path repo_path branch
  if ! docker container inspect "orchestra-$agent" >/dev/null 2>&1; then
    echo "orchestra: no agent named '$agent'" >&2
    exit 1
  fi
  worktree_path=$(docker inspect \
    -f '{{ range .Mounts }}{{ if eq .Destination "/workspace" }}{{ .Source }}{{ end }}{{ end }}' \
    "orchestra-$agent" 2>/dev/null || true)
  repo_path=$(docker inspect -f '{{ index .Config.Labels "orchestra.repo_path" }}' \
    "orchestra-$agent" 2>/dev/null || true)
  branch=$(docker inspect -f '{{ index .Config.Labels "orchestra.branch" }}' \
    "orchestra-$agent" 2>/dev/null || true)

  docker rm -f "orchestra-$agent" >/dev/null 2>&1 || true

  if [[ -n "$repo_path" && -n "$worktree_path" ]]; then
    git -C "$repo_path" worktree remove --force "$worktree_path"
  fi
  echo "Agent '$agent' removed."
  if [[ -n "$branch" ]]; then
    echo "Branch '$branch' was kept. Delete it with: git -C $repo_path branch -D $branch"
  fi
}

case "${1:-}" in
  new)
    shift
    cmd_new "$@"
    ;;
  list)
    cmd_list
    ;;
  attach)
    shift
    cmd_attach "$@"
    ;;
  stop)
    shift
    cmd_stop "$@"
    ;;
  rm)
    shift
    cmd_rm "$@"
    ;;
  *)
    usage
    ;;
esac
